# Astral Cartographer - Environment Configuration Example
# Copy to .env or configure in your environment.

# Storage location for SQLite database and extracted repository workspaces
ASTRAL_DATA_DIR=./data

# Ingestion and Archive Limits
ASTRAL_MAX_ARCHIVE_MB=100
ASTRAL_MAX_EXTRACTED_MB=500
ASTRAL_MAX_FILES=20000
ASTRAL_MAX_SINGLE_FILE_MB=20

# Source File Access Limits
ASTRAL_MAX_SOURCE_RESPONSE_MB=1

# Concurrent Background Indexing Jobs (in-process thread pool)
ASTRAL_MAX_CONCURRENT_JOBS=2

# CORS Allowed Origins (comma-separated URLs)
ASTRAL_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Server Binding
ASTRAL_HOST=127.0.0.1
ASTRAL_PORT=8000

# Google Gemini AI (Optional: Codebase Q&A, Cluster Summaries, Workflow Naming)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
